generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String   @id @default(uuid())
  username String
  password String
  added_at DateTime @default(now())
  todos    Todo[]

  @@map("users")
}

model Todo {
  id         String   @id @default(uuid())
  title      String
  added_at   DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id    String

  @@map("todos")
}
