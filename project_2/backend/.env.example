PORT=
FRONTEND_URL=
# Example: DATABASE_URL=postgresql://postgres:somepassword@127.0.0.1:5432/postgresql
# postgresql: Driver
# postgres (first occurrence): Username: The database user account you are logging in as. postgres is the default superuser/admin account created automatically when you install PostgreSQL.
# somepassword: Password: The password associated with the database user (postgres).
# 127.0.0.1: Host: The address of the database server.
# 5432: Port: The port number on which the database server is listening. 5432 is the default port for PostgreSQL.
# database_name: Database Name: The name of the specific database you want to connect to on the PostgreSQL server.
DATABASE_URL=
SALT_ROUNDS=
SECRET_KEY=
NODE_ENV=